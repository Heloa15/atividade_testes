// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  email        String        @unique
  senha        String
  agendamentos Agendamento[]
}

model Plano {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  valor       Float
  lavagensMes Int
}

model Produto {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String
  preco     Float
  estoque   Int
  imagem    String
}

model Agendamento {
  id        Int    @id @default(autoincrement())
  clienteId Int
  servico   String
  data      String
  hora      String
  status    String

  cliente Cliente @relation(fields: [clienteId], references: [id])
}
